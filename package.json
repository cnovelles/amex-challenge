{
  "name": "challenge",
  "version": "1.0.0",
  "private": true,
  "description": "People directory app with an SSR-aware caching fetch library",
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist');fs.copyFileSync('framework/mock-server/mockServiceWorker.js','dist/mockServiceWorker.js')\" && esbuild ./framework/server/index.ts --bundle --minify --platform=node --outfile=dist/server.js",
    "build:client": "esbuild ./framework/client/index.tsx --bundle --minify --platform=browser --outfile=dist/client.js",
    "start": "npm run build && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run build"
  },
  "author": "Christian Gonzalez Lopez",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "msw": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "valibot": "^0.30.0"
  },
  "msw": {
    "workerDirectory": [
      "framework/mock-server"
    ]
  }
}
