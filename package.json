{
  "name": "challenge",
  "version": "1.0.0",
  "private": true,
  "description": "People directory app with an SSR-aware caching fetch library",
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist');fs.copyFileSync('framework/mock-server/mockServiceWorker.js','dist/mockServiceWorker.js')\" && esbuild ./framework/server/index.ts --bundle --minify --platform=node --outfile=dist/server.js",
    "build:client": "esbuild ./framework/client/index.tsx --bundle --minify --platform=browser --outfile=dist/client.js",
    "start": "npm run build && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test --project=e2e",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "author": "Christian Gonzalez Lopez",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.65.0",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "amex-jest-preset": "^7.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-fixed-jsdom": "^0.0.11",
    "prettier": "^3.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "msw": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "valibot": "^0.30.0"
  },
  "msw": {
    "workerDirectory": [
      "framework/mock-server"
    ]
  }
}
