{
  "name": "challenge",
  "version": "1.0.0",
  "private": true,
  "description": "People directory app with an SSR-aware caching fetch library",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist');fs.copyFileSync('framework/mock-server/mockServiceWorker.js','dist/mockServiceWorker.js')\" && esbuild ./framework/server/index.ts --bundle --minify --platform=node --outfile=dist/server.js",
    "build:client": "esbuild ./framework/client/index.tsx --bundle --minify --platform=browser --outfile=dist/client.js",
    "start": "npm run build && node dist/server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Christian Gonzalez Lopez",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "msw": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "valibot": "^0.30.0"
  },
  "msw": {
    "workerDirectory": [
      "framework/mock-server"
    ]
  }
}
